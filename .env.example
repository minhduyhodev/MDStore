# ─── .env.example ────────────────────────────────────────────────────────────
# Copy file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env lên git — chỉ commit file này (.env.example).
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL — bắt buộc, không có giá trị mặc định an toàn
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=mdstore

# VietShare Supplier API — bắt buộc, lấy từ dashboard VietShare
VIETSHARE_API_URL=https://token.vietshare.site/v1
VIETSHARE_API_KEY=
VIETSHARE_API_SECRET=

# Redis — giữ mặc định nếu chạy local với Docker Compose
REDIS_HOST=localhost
REDIS_PORT=6379
